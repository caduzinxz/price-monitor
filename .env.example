# Configuracoes de e-mail (SMTP)
# Para Gmail, use uma "App Password" (senha de app), nunca a senha pessoal da conta.
# Como gerar: https://myaccount.google.com/apppasswords (exige verificacao em duas etapas ativada)
# Use ALERTS_ENABLED=false para desligar os e-mails sem perder as credenciais.
ALERTS_ENABLED=true

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_app_password_aqui
EMAIL_TO=email_destino@gmail.com

# Os produtos monitorados ficam em products.json (veja products.example.json).

# Regras de monitoramento
MIN_PRICE_DROP_PERCENT=10
CHECK_INTERVAL_HOURS=1
DELAY_BETWEEN_PRODUCTS_SECONDS=5

# Alerta quando o preco atinge o menor valor ja registrado, mesmo que a queda
# desde a ultima verificacao seja menor que MIN_PRICE_DROP_PERCENT.
ALERT_ON_HISTORIC_LOW=true

# Supabase (armazenamento do historico de precos)
# Project URL e chaves ficam em Project Settings > API no painel do Supabase.
# A chave secreta tem acesso privilegiado: nunca a exponha no frontend nem a versione.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
