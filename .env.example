# Configuracoes de e-mail (SMTP)
# Para Gmail, use uma "App Password" (senha de app), nunca a senha pessoal da conta.
# Como gerar: https://myaccount.google.com/apppasswords (exige verificacao em duas etapas ativada)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_app_password_aqui
EMAIL_TO=email_destino@gmail.com

# Produto monitorado
PRODUCT_URL=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html
PRODUCT_NAME=Produto de exemplo

# Seletor CSS do elemento que contem o preco na pagina (muda de site para site)
PRICE_SELECTOR=p.price_color

# Regras de monitoramento
MIN_PRICE_DROP_PERCENT=10
CHECK_INTERVAL_HOURS=1
