# Copie este arquivo para .env e preencha o que for usar.
# TUDO aqui e opcional: sem nenhuma configuracao, o projeto ja roda usando
# SQLite local e mostrando os alertas no proprio terminal.

# --- Armazenamento -----------------------------------------------------------
# "sqlite" (padrao) grava num arquivo local, sem exigir conta nenhuma.
# "supabase" usa um banco Postgres na nuvem (veja o README).
STORAGE_BACKEND=sqlite

# Preencha apenas se STORAGE_BACKEND=supabase.
# A chave secreta tem acesso privilegiado: nunca a exponha no frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Regras de monitoramento --------------------------------------------------
MIN_PRICE_DROP_PERCENT=10
CHECK_INTERVAL_HOURS=1
DELAY_BETWEEN_PRODUCTS_SECONDS=5

# Alerta quando o preco atinge o menor valor ja registrado, mesmo que a queda
# desde a ultima verificacao seja menor que MIN_PRICE_DROP_PERCENT.
ALERT_ON_HISTORIC_LOW=true

# Use false para silenciar os alertas sem apagar as credenciais abaixo.
ALERTS_ENABLED=true

# --- E-mail (opcional) --------------------------------------------------------
# Para Gmail, use uma "App Password", nunca a senha pessoal da conta:
# https://myaccount.google.com/apppasswords (exige verificacao em duas etapas)
# Deixe em branco para nao enviar e-mail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# --- Telegram (opcional) ------------------------------------------------------
# 1. Crie um bot com o @BotFather e cole o token abaixo
# 2. Mande qualquer mensagem para o seu bot no Telegram
# 3. Rode: python -m scripts.get_telegram_chat_id
# O token da controle total do bot: trate como senha.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Os produtos monitorados ficam em products.json (veja products.example.json).
